# Copie para .env.local e preencha os valores.
# Na Vercel: Settings → Environment Variables (Production e Preview).
# yuna/ e yuna-v2/ usam a mesma planilha (mesma URL e secret).

# --- Google Sheets (Apps Script) ---
# URL do deploy: Extensões > Apps Script > Deploy > App da Web
# Cabeçalhos na planilha (linha 1): Data | Nome | Email | Telefone | Mensagem
GOOGLE_SHEETS_WEBHOOK_URL=

# Mesma chave definida em WEBHOOK_SECRET no Apps Script
GOOGLE_SHEETS_WEBHOOK_SECRET=belgos-yuna-v2

# --- Opcional: CORS ---
# Origens permitidas (separadas por vírgula). Vazio = qualquer origem.
# Exemplo: https://yuna.com.br,https://www.yuna.com.br,*.vercel.app
ALLOWED_ORIGINS=
